PORT=5000
# Runtime connection used by the app (pooled connection is fine, e.g. pgBouncer).
DATABASE_URL="postgresql://user:password@localhost:5432/hybrid_ledger"
# DIRECT (non-pooled) connection used by the Prisma CLI (prisma.config.ts) for
# schema changes: `npx prisma db push` / `npx prisma db execute`. Required to
# apply migrations — a missing DIRECT_URL is why a new column (e.g.
# savings_usages.kind) can exist in schema.prisma but not in the database.
DIRECT_URL="postgresql://user:password@localhost:5432/hybrid_ledger"
JWT_SECRET="supersecret_jwt_key_here"
VAPID_PUBLIC_KEY="your_public_vapid_key_here"
VAPID_PRIVATE_KEY="your_private_vapid_key_here"
VAPID_EMAIL="mailto:admin@example.com"
FRONTEND_URL="https://budgetbarkada.vercel.app"

# ── AI features (LLM-Powered Insights & Smart Category Icons) ──────────
# Optional. When GEMINI_API_KEY (or GROQ_API_KEY) is unset, AI insights and
# smart icons silently fall back to heuristics — nothing breaks.
# LLM_PROVIDER selects the backend: "gemini" (default) or "groq".
LLM_PROVIDER="gemini"
# Google AI Studio key (free tier, no credit card). Backend-only; never shipped
# to the frontend and never logged.
GEMINI_API_KEY=""
# Alternative provider (OpenAI-compatible). Used when LLM_PROVIDER=groq.
GROQ_API_KEY=""
# Optional model override (defaults: gemini-flash-lite-latest / llama-3.3-70b-versatile).
# Tip: the "-latest" Gemini alias stays on the current free flash-lite model;
# pin an exact version here only if you need reproducible output.
LLM_MODEL=""
